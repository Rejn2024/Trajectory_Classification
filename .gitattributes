# Published training results and flight corpora use LFS by default, including
# large JSON/CSV logs and new binary formats. Local artifacts stay Git-ignored.
shared/** filter=lfs diff=lfs merge=lfs -text

# Keep small documentation, configuration, and provenance readable in Git.
shared/**/*.md !filter !diff !merge text
shared/**/*.yaml !filter !diff !merge text
shared/**/*.yml !filter !diff !merge text
shared/**/manifest.json !filter !diff !merge text
shared/**/config.json !filter !diff !merge text
shared/**/metrics.json !filter !diff !merge text
shared/**/summary.json !filter !diff !merge text
shared/**/label_map.json !filter !diff !merge text
shared/**/schema.json !filter !diff !merge text

# Keep published metadata checksums stable across Windows and Unix checkouts.
shared/corpora/tactical-episodes-v1/*.json text eol=lf
shared/corpora/tactical-episodes-v1/*.md text eol=lf
shared/corpora/trained-pilot-episodes-v1/*.json text eol=lf
shared/corpora/trained-pilot-episodes-v1/*.md text eol=lf
shared/replays/tactical-checkpoints-v1/*.json text eol=lf
shared/replays/tactical-checkpoints-v1/*.md text eol=lf

# Keep the small offline video player and its provenance directly readable.
shared/demonstrators/tactical-checkpoints-v1/index.html !filter !diff !merge text eol=lf
shared/demonstrators/tactical-checkpoints-v1/*.json !filter !diff !merge text eol=lf
shared/demonstrators/tactical-checkpoints-v1/*.md text eol=lf
